# Скопируйте в .env и поменяйте значения. Без .env docker compose берёт значения по умолчанию.
DB_NAME=carsharing
DB_USER=carsharing
DB_PASSWORD=change-me
DB_PORT=5432
APP_PORT=8080

# Сколько живёт бронь до старта, минут. Должно быть больше бесплатных минут тарифа.
RENTAL_RESERVATION_TTL_MINUTES=30
# Ниже этого уровня топлива после поездки создаётся наряд на заправку, процентов.
FUEL_LOW_THRESHOLD_PERCENT=15
# default: только схема; default,demo: схема и демо-данные.
LIQUIBASE_CONTEXTS=default,demo
